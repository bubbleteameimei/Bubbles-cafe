# Always use the official npm registry — prevents Replit-local proxy URLs
# from being embedded in package-lock.json and breaking CI/CD (e.g. Render)
registry=https://registry.npmjs.org/

# Prevent Puppeteer from downloading Chromium/Chrome during npm install/ci
puppeteer_skip_download=true

# Keep npm output concise in CI
fund=false
audit=false