# Server
NODE_ENV=development

# Database (PostgreSQL)
# Example Supabase connection string
# Find this in Supabase Dashboard -> Project Settings -> Database
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
# DB pool tuning (helps close connections quickly when idle)
DB_POOL_IDLE_MS=5000
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_POOL_CONN_TIMEOUT_MS=10000
# If using Neon, optionally force the pooled host in production (leave false for Supabase)
DB_FORCE_NEON_POOLER=false

# Session
SESSION_SECRET=please-change-me-to-a-long-random-string-of-64-chars-min

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
# API base URL used by the frontend (set this on Vercel to point to your Render backend in production)
VITE_API_URL=http://localhost:5000

# WordPress API
WORDPRESS_API_URL=https://public-api.wordpress.com/wp/v2/sites/bubbleteameimei.wordpress.com/posts
# Disable background sync scheduler by default in production (enable when needed)
ENABLE_WORDPRESS_SCHEDULER=false

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/callback

# Client-side GIS config (optional)
# If set, the React component will initialize GIS in redirect or popup mode using these values.
VITE_GOOGLE_CLIENT_ID=
# 'popup' or 'redirect'
VITE_GOOGLE_UX_MODE=popup
# Used when VITE_GOOGLE_UX_MODE=redirect
VITE_GOOGLE_LOGIN_URI=http://localhost:5000/api/auth/callback

# Email (optional)
GMAIL_APP_PASSWORD=
SENDGRID_API_KEY=
MAILERSEND_API_KEY=

# Client features
VITE_ENABLE_ERROR_REPORTING=false