# Server
NODE_ENV=development

# Database (PostgreSQL)
# Prefer Supabase Connection Pooler for application runtime
# Set SUPABASE_POOLER_URL to your pooler connection string from:
# Supabase Dashboard → Project Settings → Database → Connection Pooling
# Example:
# SUPABASE_POOLER_URL=postgresql://postgres:YOUR_PASSWORD@aws-1-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_POOLER_URL=
# Alternatively, you can set DATABASE_URL directly to the same pooler URL:
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@aws-1-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
# DB pool tuning (helps close connections quickly when idle)
DB_POOL_IDLE_MS=5000
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_POOL_CONN_TIMEOUT_MS=10000

# Supabase Auth
# Set to your Supabase project URL (no trailing slash)
SUPABASE_URL=https://rqoqtusrlsapcbdimwpn.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional: helps /api/health/supabase detect config mismatches
EXPECTED_SUPABASE_URL=https://rqoqtusrlsapcbdimwpn.supabase.co

# Optional: expose to client if using supabase-js on the frontend
VITE_SUPABASE_URL=https://rqoqtusrlsapcbdimwpn.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Session
SESSION_SECRET=please-change-me-to-a-long-random-string-of-64-chars-min

# Frontend / backend URLs
# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
# Backend base URL used by the frontend and scripts (set this on Render/Cloudflare)
BACKEND_BASE_URL=http://localhost:5000
# API base URL used by the frontend (set this on Vercel to point to your backend in production)
VITE_API_URL=http://localhost:5000

# WordPress API
# Prefer WORDPRESS_API where possible; WORDPRESS_API_URL is kept for compatibility.
WORDPRESS_API=https://public-api.wordpress.com/wp/v2/sites/bubbleteameimei.wordpress.com
WORDPRESS_API_URL=https://public-api.wordpress.com/wp/v2/sites/bubbleteameimei.wordpress.com/posts
# Disable background sync scheduler by default in production (enable when needed)
ENABLE_WORDPRESS_SCHEDULER=false

# Auth toggles
# Disable legacy username/password auth when using Supabase Auth only
DISABLE_LOCAL_AUTH=false

# OAuth (optional, legacy Google settings no longer required with Supabase Auth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/callback

# Client-side GIS config (optional, legacy)
# If set, the React component will initialize GIS in redirect or popup mode using these values.
VITE_GOOGLE_CLIENT_ID=
# 'popup' or 'redirect'
VITE_GOOGLE_UX_MODE=popup
# Used when VITE_GOOGLE_UX_MODE=redirect
VITE_GOOGLE_LOGIN_URI=http://localhost:5000/api/auth/callback

# Email (optional)
GMAIL_APP_PASSWORD=
GMAIL_ADMIN_EMAIL=
SENDGRID_API_KEY=
MAILERSEND_API_KEY=
EMAIL_PROVIDER_API_KEY=

# Payments (Paystack)
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
# Direct checkout link for "Buy me a coffee" style buttons
PAYSTACK_LINK=
# Optional: expose the Paystack link directly to the client via Vite
VITE_PAYSTACK_LINK=

# Build tooling / CI
# Max bundle size in kilobytes for CI checks (e.g. 1500 or "1500kb")
BUNDLE_BUDGET_KB=400

# Client features
# Session CSRF (legacy Express mock-server only). Leave false for Cloudflare Worker + Supabase JWT.
VITE_ENABLE_CSRF=false
VITE_ENABLE_ERROR_REPORTING=false
# Rotate \"Best Stories\" selection every N days (minimum 3)
VITE_BEST_STORIES_ROTATION_DAYS=7
# Enable/disable PWA service worker registration in the client
VITE_ENABLE_SW=true

# Cloudflare (optional, used only by deployment scripts or Wrangler)
CLOUDFLARE_API_TOKEN=