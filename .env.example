# Server
NODE_ENV=development
PORT=3002

# Database (PostgreSQL)
# Example Neon connection string
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Session
SESSION_SECRET=please-change-me-to-a-long-random-string-of-64-chars-min

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# WordPress API
WORDPRESS_API_URL=https://public-api.wordpress.com/wp/v2/sites/bubbleteameimei.wordpress.com/posts

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (optional)
GMAIL_APP_PASSWORD=
SENDGRID_API_KEY=
MAILERSEND_API_KEY=

# Client features
VITE_ENABLE_ERROR_REPORTING=false