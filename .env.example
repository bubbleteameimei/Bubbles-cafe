# Server
NODE_ENV=development

# Database (PostgreSQL)
# Example Neon connection string
# Strongly recommended: use the Neon pooled host (-pooler.neon.tech) for serverless autosleep friendliness
# DATABASE_URL=postgresql://user:password@ep-xxxxx-pooler.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Session
SESSION_SECRET=please-change-me-to-a-long-random-string-of-64-chars-min

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
# API base URL used by the frontend (set this on Vercel to point to your Render backend in production)
VITE_API_URL=http://localhost:5000

# WordPress API
WORDPRESS_API_URL=https://public-api.wordpress.com/wp/v2/sites/bubbleteameimei.wordpress.com/posts

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/callback

# Client-side GIS config (optional)
# If set, the React component will initialize GIS in redirect or popup mode using these values.
VITE_GOOGLE_CLIENT_ID=
# 'popup' or 'redirect'
VITE_GOOGLE_UX_MODE=popup
# Used when VITE_GOOGLE_UX_MODE=redirect
VITE_GOOGLE_LOGIN_URI=http://localhost:5000/api/auth/callback

# Email (optional)
GMAIL_APP_PASSWORD=
SENDGRID_API_KEY=
MAILERSEND_API_KEY=

# Client features
VITE_ENABLE_ERROR_REPORTING=false