{
  "name": "bubbles-cafe-worker",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-19",
  "env": {
    "production": {
      "routes": [
        {
          "pattern": "https://bubbles-cafe.space/*",
          "zone_id": ""
        }
      ],
      "vars": {
        "BACKEND_URL": "https://api.bubblescafe.space"
      }
    },
    "development": {
      "vars": {
        "BACKEND_URL": "http://localhost:3000"
      }
    }
  }
}
