modules = ["nodejs-20", "web", "postgresql-16", "python-3.11"]
run = "bash -c 'npm install && npm run dev'"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]
exposeLocalhost = true

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "cloudrun"
build = ["sh", "-c", "npm install && npm run build"]
run = ["sh", "-c", "npm start"]

[[ports]]
localPort = 3002
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 5000

[workflows]
runButton = "Start App"

[[workflows.workflow]]
name = "Start Web Feedback App"
author = 40492995
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm cache clean --force"
waitForPort = 3002

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm install"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run start "

[[workflows.workflow]]
name = "Start App"
author = 47589424
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm cache clean --force"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm install"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run start"

[agent]
integrations = ["javascript_database:1.0.0"]
